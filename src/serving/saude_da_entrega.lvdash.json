{
  "datasets": [
    {
      "name": "ds_carteira",
      "displayName": "Carteira (gold.kpi_carteira)",
      "queryLines": [
        "SELECT data_corte, projetos_em_andamento, projetos_criticos, projetos_em_atencao, projetos_melancia, ",
        "estouro_previsto_total, maior_estouro_projeto, maior_estouro_valor ",
        "FROM kpi_carteira"
      ]
    },
    {
      "name": "ds_projetos",
      "displayName": "Projetos (gold.kpi_projeto)",
      "queryLines": [
        "SELECT projeto_id, cliente, segmento, ferramenta, gerente, ",
        "round(spi, 2) AS spi, round(cpi, 2) AS cpi, ",
        "pct_concluido_calculado / 100 AS pct_concluido, pct_planejado / 100 AS pct_planejado, ",
        "bac, ac, eac, estouro_previsto, situacao, farol_declarado, farol_calculado, ",
        "CASE WHEN melancia THEN 'sim' ELSE 'não' END AS melancia ",
        "FROM kpi_projeto ",
        "ORDER BY spi"
      ]
    },
    {
      "name": "ds_top_estouro",
      "displayName": "Top 10 estouro (gold.kpi_projeto)",
      "queryLines": [
        "SELECT projeto_id, cliente, estouro_previsto ",
        "FROM kpi_projeto ",
        "WHERE estouro_previsto > 0 ",
        "ORDER BY estouro_previsto DESC ",
        "LIMIT 10"
      ]
    }
  ],
  "pages": [
    {
      "name": "saude_da_entrega",
